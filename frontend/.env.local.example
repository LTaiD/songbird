# Copy to .env.local (dev) / .env.production (baked in at build for the
# Cloudflare Pages deploy — static export reads env at build time, not runtime).
NEXT_PUBLIC_API_URL=http://localhost:8000
# From your Supabase project (Settings -> API). Leave unset to run without
# accounts — record/transcribe/edit still work, saving is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
