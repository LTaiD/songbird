# Copy to .env.local (dev) / set in Vercel project settings (prod).
NEXT_PUBLIC_API_URL=http://localhost:8000
# From your Supabase project (Settings -> API). Leave unset to run without
# accounts — record/transcribe/edit still work, saving is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
